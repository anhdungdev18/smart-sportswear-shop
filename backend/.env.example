# Copy to .env for local docker-compose usage. Spring reads the same names
# directly from the process environment (see application.yml).

# DB_HOST=postgres + DB_PORT=5432 when the Spring app itself runs inside
# docker-compose; use DB_HOST=localhost + DB_PORT=5433 when running the app
# directly on the host against the compose Postgres (see DB_HOST_PORT below).
DB_HOST=postgres
DB_PORT=5432
DB_NAME=dunghaiquyen
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Host-side port for docker-compose's postgres service. Default 5433 to avoid
# clashing with a native Postgres install that may already use 5432.
DB_HOST_PORT=5433

REDIS_HOST=redis
REDIS_PORT=6379

JWT_ACCESS_SECRET=change-me-access-secret-min-32-bytes
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-bytes
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

MAIL_FROM=no-reply@dunghaiquyen.local
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_AUTH=false
SMTP_STARTTLS=false

ORDER_PENDING_EXPIRY_MINUTES=30

VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
PAYMENT_RETURN_URL=http://localhost:3000/payment/result
PAYMENT_CALLBACK_URL=http://localhost:8080/api/v1/payments/callback

CORS_ALLOWED_ORIGINS=http://localhost:3000
SERVER_PORT=8080
