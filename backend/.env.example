# Copy to .env and point these at your real Postgres instance. For this
# project, Supabase is the intended default, not a local Docker database.
# Spring builds the JDBC URL as:
#   jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}${DB_PARAMS}
# so DB_PARAMS must include the leading '?' when you need SSL/options.
#
# Supabase examples:
# - Direct connection usually uses port 5432
# - Transaction pooler often uses port 6543
# - Most setups need sslmode=require
DB_HOST=your-supabase-host.supabase.co
DB_PORT=5432
DB_NAME=dunghaiquyen
DB_USERNAME=your-supabase-user
DB_PASSWORD=your-supabase-password
DB_PARAMS=?sslmode=require

REDIS_HOST=localhost
REDIS_PORT=6379

JWT_ACCESS_SECRET=change-me-access-secret-min-32-bytes
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-bytes
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# APP_MAIL_PROVIDER=logging (default) only logs what would have been sent -
# safe for local/dev/test, no SMTP server required. Set to "smtp" to send
# real email via SmtpMailService - see backend/README.md "SMTP / Gmail setup"
# for a concrete Gmail App Password walkthrough. Any other value fails app
# startup outright (no MailService bean matches), not a silent wrong fallback.
APP_MAIL_PROVIDER=logging
MAIL_FROM=no-reply@dunghaiquyen.local
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS_ENABLE=false

ORDER_PENDING_EXPIRY_MINUTES=30

# VNPAY_HASH_SECRET must never be blank, even for local/demo use: it is used
# as an HMAC-SHA512 key (VnpaySignatureService), and a zero-length key throws
# outright - this took down the Phase M seed run the first time it was
# actually exercised outside the test profile.
VNPAY_TMN_CODE=DEVTMNCODE
VNPAY_HASH_SECRET=dev-only-vnpay-hash-secret-change-me-please
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
PAYMENT_RETURN_URL=http://localhost:3000/payment/result
PAYMENT_CALLBACK_URL=http://localhost:8080/api/v1/payments/callback

# Comma-separated. storefront=3000, admin=3001
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
SERVER_PORT=8080

# Admin reports: a variant counts as "low stock" once (stock - reserved) <=
# this. No threshold is specified anywhere in the Phase 1 spec - see
# ReportService for the tradeoff.
LOW_STOCK_THRESHOLD=10

# No real shipping engine - flat fee, waived once subtotal reaches the
# free-shipping threshold. Both 0/huge by default so shippingFee stays 0
# (pre-existing behavior) until you explicitly opt in. Used identically by
# checkout (OrderService) and checkout preview - see OrderService.calculateShippingFee.
SHIPPING_FLAT_FEE=0
SHIPPING_FREE_THRESHOLD=999999999999

# Forgot/reset password (Phase L). TTL per PHASE1_SPEC.md 6.1's suggestion.
# PASSWORD_RESET_URL is where the (logging-only, see LoggingMailService) reset
# email points the customer - no real frontend page exists yet this phase.
PASSWORD_RESET_TOKEN_TTL_MINUTES=15
PASSWORD_RESET_URL=http://localhost:3000/reset-password

# Demo seed data (Phase M). Keep disabled in normal app starts; enable only
# when you explicitly want the local demo dataset created/refreshed.
APP_SEED_ENABLED=false
APP_SEED_DEMO_PASSWORD=Password123

# Google OAuth2 (V9 Google login). Create a Web Client ID at
# https://console.cloud.google.com/apis/credentials for your project.
# Backend verifies ID tokens sent by the frontend and checks the "aud" claim
# matches this value. Leave blank for local dev/tests that never call the
# Google login endpoint (/api/v1/auth/google).
GOOGLE_CLIENT_ID=

# APP_STORAGE_PROVIDER=none (default) keeps the legacy manual-image-URL flow
# working with zero setup. Set to "cloudinary" to enable real product-image
# uploads (POST .../images/upload) - see backend/README.md "Cloudinary setup"
# for how to get these 3 values from the Cloudinary dashboard. Any other
# value fails app startup outright, same rule as APP_MAIL_PROVIDER.
APP_STORAGE_PROVIDER=none
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
