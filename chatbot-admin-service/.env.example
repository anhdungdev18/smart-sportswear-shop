ADMIN_COPILOT_ENV=development
ADMIN_COPILOT_HOST=0.0.0.0
ADMIN_COPILOT_PORT=8003

CORE_BACKEND_API_BASE_URL=http://localhost:8082
FORECASTING_API_BASE_URL=http://localhost:8081

JWT_ACCESS_SECRET=replace-with-exact-same-value-as-backend
JWT_ACCESS_ALGORITHM=HS256

REDIS_URL=redis://localhost:6379
SESSION_TTL_SECONDS=3600

MODEL_PROVIDER=none
MODEL_NAME=deterministic-readonly-v1
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

MAX_AGENT_STEPS=4
MAX_TOOL_CALLS_PER_RUN=6
AGENT_TIMEOUT_SECONDS=30
TOOL_TIMEOUT_SECONDS=8
MAX_INPUT_CHARS=4000

READ_ONLY_MODE=true
WRITE_TOOLS_ENABLED=false
APPROVALS_ENABLED=false
APPROVAL_STORAGE_BACKEND=sqlite
APPROVAL_SQLITE_PATH=data/admin_agent_approvals.sqlite3
APPROVAL_DB_HOST=
APPROVAL_DB_PORT=5432
APPROVAL_DB_NAME=postgres
APPROVAL_DB_USERNAME=
APPROVAL_DB_PASSWORD=
APPROVAL_DB_SSLMODE=require

OBSERVABILITY_ENABLED=true
EVALUATION_LOGGING_ENABLED=true
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:3001
RATE_LIMIT_PER_MINUTE=60
