VISUAL_SEARCH_ENABLED=false
VISUAL_EMBEDDING_PROVIDER=fake
VISUAL_EMBEDDING_MODEL=voyage-multimodal-3.5
VISUAL_EMBEDDING_DIMS=1024
VOYAGE_API_KEY=
VOYAGE_API_URL=https://api.voyageai.com/v1/multimodalembeddings
VOYAGE_TIMEOUT_SECONDS=30
VOYAGE_MAX_ATTEMPTS=3
DATABASE_URL=
# Use localhost when the Python service runs directly on the host. Use
# rabbitmq as the hostname only when the service runs inside Docker Compose.
RABBITMQ_URL=amqp://visual_search:change-me@localhost:5672/
RABBITMQ_PREFETCH_COUNT=5
RABBITMQ_CONSUMER_QUEUE=visual-search.indexing
RABBITMQ_RETRY_QUEUES=visual-search.indexing.retry.30s,visual-search.indexing.retry.5m,visual-search.indexing.retry.1h
RABBITMQ_DLQ=visual-search.indexing.dlq
READINESS_TIMEOUT_SECONDS=10
INTERNAL_SERVICE_TOKEN=
CLOUDINARY_CLOUD_NAME=
CATALOG_IMAGE_ALLOWED_HOSTS=res.cloudinary.com,cdn.shopify.com
MAX_UPLOAD_BYTES=5242880
MAX_IMAGE_PIXELS=12000000
TARGET_IMAGE_MAX_WIDTH=1024
TARGET_IMAGE_MAX_HEIGHT=1024
CATALOG_DOWNLOAD_TIMEOUT_SECONDS=10
CATALOG_DOWNLOAD_MAX_REDIRECTS=3
SEARCH_RATE_LIMIT_PER_MINUTE=10
MONTHLY_BUDGET_USD=20
STORE_QUERY_IMAGES=false
