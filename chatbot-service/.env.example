# Runtime environment
CHATBOT_ENV=development
CHATBOT_HOST=0.0.0.0
CHATBOT_PORT=8002

# Model
MODEL_PROVIDER=anthropic
MODEL_NAME=claude-sonnet-4-6

# DB read-only connection (Supabase PostgreSQL)
DB_READ_URL=postgresql+asyncpg://user:password@host:5432/dbname

# Backend Spring Boot API (for transaction tools — Phase 5+)
BACKEND_API_BASE_URL=http://localhost:8080

# Redis (for session/memory — Phase 9+)
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=INFO

# LLM API key
ANTHROPIC_API_KEY=sk-ant-...

# Embeddings (Phase 8+)
OPENAI_API_KEY=sk-...
